# Copy to .env only on a fresh clone. Never overwrite existing user values.
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_CURRENCY=USD
# Local operator sign-in is required before any sandbox purchase/refund action.
OPERATOR_PASSWORD=
# For npm start serving the built UI, change this to http://127.0.0.1:4331
REFUND_RIGHT_WEB_ORIGIN=http://127.0.0.1:5173
REFUND_RIGHT_DB=data/refund-right.sqlite

GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.8-flash
GEMINI_THINKING_LEVEL=medium
GEMINI_MAX_OUTPUT_TOKENS=65536
# Enable only with an explicitly authorized cap (this project currently permits at most $10).
GEMINI_REQUESTS_ENABLED=false
GEMINI_BUDGET_USD=0

